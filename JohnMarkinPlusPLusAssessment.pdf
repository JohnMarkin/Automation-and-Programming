       "2022-01-01    January 2022       -0.002701\n",
       "\n",
       "[1132 rows x 2 columns]"
      ]
     },
     "execution_count": 356,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "\n",
    "# Create a copy of the data to avoid tampering \n",
    "\n",
    "data2 = data.copy()\n",
    "\n",
    "# Create a new column Dates to help subsetting\n",
    "data2[\"Dates\"] = data2.index\n",
    "data2[\"Dates\"] = data2['Dates'].dt.strftime('%B %Y')\n",
    "\n",
    "# Calculate the daily log returns\n",
    "\n",
    "x = data2['Adj Close']\n",
    "data2['Monthly_return'] = np.log(data2['Adj Close'] / data2['Adj Close'].shift(1))\n",
    "\n",
    "# Calculate the monthly returns and group the returns based Month and Year\n",
    "final =pd.DataFrame(data2.groupby(['Dates'] )['Monthly_return'].apply(statistics.mean) )\n",
    "final[\"Month&Year\"] = final.index\n",
    "final.index = pd.to_datetime(final.index, format='%B %Y')\n",
    "final[\"year\"] = final.index.year\n",
    "final = final.sort_values(by= 'year')\n",
    "final = final[[ \"Month&Year\" , \"Monthly_return\"  ]]\n",
    "final\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "73f50b4b",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Saving File to Monthly Returns.txt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 360,
   "id": "f40f6056",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save the file to a comma delimited text file\n",
    "final.to_csv('/Users/johnmarkin/Downloads/Python for Finance/Monthly Returns.txt', index = False)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "92843191",
   "metadata": {},
   "source": [
    "# Part 3: Visualizations:\n",
    "\n",
    "The plot shows that monthly returns  over the years are quite similar they range between (-0.005, 0.01). However, there are some outliers out of this range but the frequency of such points provide no substantial information in deciding the appropriate month. \n",
    "So ignoring outliers, October will be the most volatile month as the returns are more spaced indicating a higher volatility.\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 343,
   "id": "6a8d542d",
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<AxesSubplot:xlabel='month', ylabel='Monthly_return'>"
      ]
     },
     "execution_count": 343,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "\n",
      "text/plain": [
       "<Figure size 1080x576 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "# Visualizing Volatile Month by Returns\n",
    "final[\"month\"] = pd.to_datetime(final.index)\n",
    "final['month'] = final['month'].dt.month_name()\n",
    "\n",
    "# plot scatter plot based on seaborn\n",
    "sns.set(rc = {'figure.figsize':(15,8)})\n",
    "sns.scatterplot(x = 'month' , y = 'Monthly_return', data = final)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9384edfc",
   "metadata": {},
   "source": [
    "Quantitatively, I will use the Standard Deviation to determine the most volatile month.\n",
    "from the above plot we observe that the points are clustered around (-0.005, 0.01).\n",
    "The higher  the standard deviation , the more the values for that month deviate from the mean. This will serve as useful basis to compare the other months. \n",
    "\n",
    "September reported the highest value: 0.002991"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 344,
   "id": "fedd12e3",
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Monthly_stdev    0.002991\n",
       "Name: September, dtype: float64"
      ]
     },
     "execution_count": 344,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "\n",
    "final2 = final.copy()\n",
    "\n",
    "#Remove NaN\n",
    "final2 = final2.iloc[1:,:]\n",
    "\n",
    "# Calculate monthly returns and group the returns based on Month and Year\n",
    "\n",
    "\n",
    "final2[\"Month&Year\"] = final2.index\n",
    "\n",
    "final2.index = pd.to_datetime(final2.index, format='%B %Y')\n",
    "\n",
    "# create a column of the months\n",
    "\n",
    "final2[\"month\"] = final2.index.month\n",
    "final2['month'] = final2['month'].apply(lambda x: calendar.month_name[x])\n",
    "\n",
    "# Further calculate the standard deviation on the grouped identical months\n",
    "\n",
    "final2 =pd.DataFrame(final2.groupby(['month'] )['Monthly_return'].apply(statistics.stdev) )\n",
    "\n",
    "# Get the index of the maximum stdev\n",
    "max_index = final2[\"Monthly_return\"].idxmax()\n",
    "\n",
    "#rename columns\n",
    "final2  = final2.rename(columns = {'Monthly_return':'Monthly_stdev'})\n",
    "\n",
    "#print final results\n",
    "final2.loc[max_index]"
   ]
  }
 ],
