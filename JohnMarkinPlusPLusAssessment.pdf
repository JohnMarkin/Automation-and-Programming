   "source": [
    "# Part 2:  Monthly Means \n",
    "\n",
    "Mean is calculated using arithmetic average \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 353,
   "id": "7179573a",
   "metadata": {},
   "outputs": [],
   "source": [
